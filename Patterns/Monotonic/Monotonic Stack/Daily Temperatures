https://leetcode.com/problems/daily-temperatures/

**********************************************************************************************************************************************************************
Brute Approach - 
For each day, linearly scan all future days to find the first warmer temperature and store the difference of days in result array.
TC - O(n^2)
SC - O(1)

**********************************************************************************************************************************************************************
Optimal Approach -
Traverse the array once and use a monotonic decreasing stack of indices. Whenever a warmer temperature appears, pop the indices and store the day difference.
TC - O(n)
SC - O(n)

public int[] dailyTemperatures(int[] temperatures) {
        int n = temperatures.length;
        int[] answer = new int[n];
        Stack<Integer> stack = new Stack<>();

        for(int i=0; i<n; i++){
            // jab tak stack empty nhi ho jata & curr element stack ke top element se bada hai tab tk pop krte chalo
            while(!stack.isEmpty() && temperatures[i] > temperatures[stack.peek()]){
                int poppedIdx = stack.pop();
                answer[poppedIdx] = i-poppedIdx;// store diff of popped and curr index
            }
            stack.push(i);// push curr index
        }
        return answer;

    }
