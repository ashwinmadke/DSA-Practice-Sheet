https://leetcode.com/problems/maximum-width-ramp/

TC - O(n)
SC - O(n)

public int maxWidthRamp(int[] nums) {
        int n = nums.length;
        Stack<Integer> stack = new Stack<>();

        // build the descreasing monotonic stack
        for(int i=0; i<n; i++){
            if(stack.isEmpty() || nums[stack.peek()] > nums[i]){
                stack.push(i);
            }
        }
        int maxWidth = 0;
        // treverse from right to left to get maxwidth
        for(int j=n-1; j>=0; j--){
            while(!stack.isEmpty() && nums[j] >= nums[stack.peek()]){
                int poppedIdx = stack.pop();    
                maxWidth = Math.max(maxWidth, j - poppedIdx);
                
            }
        }
        return maxWidth;
    }
